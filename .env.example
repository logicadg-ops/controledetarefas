# Painel de Tarefas — Condomais PE
# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings > API no painel do Supabase).

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole-aqui-a-anon-key

# Usada apenas em Server Actions administrativas (convidar usuário via
# Supabase Auth, criar empresas). NUNCA exponha esta chave no navegador nem
# faça commit dela.
SUPABASE_SERVICE_ROLE_KEY=cole-aqui-a-service-role-key

# URL pública do app (usada para montar os links de convite/recuperação de senha).
# Em produção, use a URL real (ex: https://tarefas.condomais.com.br).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
